    },
    "It may still ask you to sign in to Factory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise wirst du trotzdem gebeten, dich bei Factory anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may still ask you to sign in to Factory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que aun así te pida iniciar sesión en Factory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut quand même vous demander de vous connecter à Factory."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe chiedere comunque l'accesso a Factory."
          }
        }
      }
    },
