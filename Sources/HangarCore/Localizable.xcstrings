    "Hangar: cannot read the key file": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangar: Schlüsseldatei kann nicht gelesen werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangar: cannot read the key file"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangar: no se puede leer el archivo de clave"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangar : impossible de lire le fichier de clé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangar: non riesco a leggere il file chiave"
          }
        }
