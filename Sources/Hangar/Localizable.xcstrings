      "comment": "The second value is “ (~/.claude)” or empty",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Anmeldung und die Einstellungen, mit denen %@ bereits eingerichtet ist%@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the login and settings %@ is already set up with%@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el inicio de sesión y los ajustes con los que %@ ya está configurado%@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la connexion et les réglages déjà configurés pour %@%@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'accesso e le impostazioni con cui %@ è già configurato%@."
          }
        }
      }
    },
    "Waiting for the server": {
      "localizations": {
