          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está instalado. Para instalarlo, en el terminal:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas installé. Pour l’installer, dans le terminal :"
          }
