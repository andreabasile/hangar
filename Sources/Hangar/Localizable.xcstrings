    "Working folder. You can also drag a folder onto it from the Finder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsordner. Du kannst auch einen Ordner aus dem Finder hierher ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working folder. You can also drag a folder onto it from the Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta de trabajo. También puedes arrastrar aquí una carpeta desde el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier de travail. Vous pouvez aussi y faire glisser un dossier depuis le Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella di lavoro. Puoi anche trascinarci sopra una cartella dal Finder."
          }
        }
      }
    },
    "Writes one Tab Config per preset to ~/.warp/tab_configs and opens it in a new window with warp://tab_config. The configs also appear in Warp’s + menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt eine Tab Config pro Preset nach ~/.warp/tab_configs und öffnet sie in einem neuen Fenster mit warp://tab_config. Die Konfigurationen erscheinen auch im +-Menü von Warp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes one Tab Config per preset to ~/.warp/tab_configs and opens it in a new window with warp://tab_config. The configs also appear in Warp’s + menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una Tab Config por preajuste en ~/.warp/tab_configs y la abre en una ventana nueva con warp://tab_config. Las configuraciones también aparecen en el menú + de Warp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit une Tab Config par préréglage dans ~/.warp/tab_configs et l’ouvre dans une nouvelle fenêtre avec warp://tab_config. Les configurations apparaissent aussi dans le menu + de Warp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive una Tab Config per preset in ~/.warp/tab_configs e la apre in una nuova finestra con warp://tab_config. Le configurazioni compaiono anche nel menu + di Warp."
          }
        }
      }
    },
