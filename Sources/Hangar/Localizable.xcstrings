    "Without authentication, Claude Code gets the dummy key “%@”, since it wants one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Authentifizierung erhält Claude Code den Platzhalterschlüssel „%@“, da es einen verlangt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without authentication, Claude Code gets the dummy key “%@”, since it wants one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin autenticación, Claude Code recibe la clave ficticia “%@”, porque necesita una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans authentification, Claude Code reçoit la clé factice « %@ », car il en exige une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza autenticazione Claude Code riceve la chiave fittizia «%@», perché ne vuole una."
          }
        }
      }
    },
    "Without authentication, no key is sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Authentifizierung wird kein Schlüssel gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without authentication, no key is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin autenticación, no se envía ninguna clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans authentification, aucune clé n’est envoyée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza autenticazione non viene inviata nessuna chiave."
          }
        }
      }
    },
    "Working folder": {
      "localizations": {
