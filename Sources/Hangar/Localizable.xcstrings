        }
      }
    },
    "%@ is not installed. To install it, in the terminal:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht installiert. Zum Installieren im Terminal:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
