        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è installato. Per installarlo, nel terminale:"
          }
        }
      }
    },
    "%@.\nFix it: the app reads it again as soon as you save it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@.\nKorrigiere sie: Die App liest sie erneut, sobald du sie sicherst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@.\nFix it: the app reads it again as soon as you save it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@.\nCorrígelo: la app lo vuelve a leer en cuanto lo guardes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@.\nCorrigez-le : l’app le relit dès que vous l’enregistrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@.\nCorreggilo: l'app lo rilegge appena lo salvi."
          }
        }
      }
    },
