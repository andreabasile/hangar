{
  "sourceLanguage": "en",
  "strings": {
    "%@ does not allow separate accounts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erlaubt keine separaten Accounts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not allow separate accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no permite cuentas independientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne permet pas de comptes distincts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non permette account separati."
          }
        }
      }
    },
    "%@ is not installed": {
