    "Every change is saved to config.json at once, and edits made to the file in another editor show up here as soon as you save them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung wird sofort in config.json gesichert, und Änderungen an der Datei in einem anderen Editor erscheinen hier, sobald du sie sicherst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every change is saved to config.json at once, and edits made to the file in another editor show up here as soon as you save them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio se guarda al momento en config.json, y los cambios hechos en el archivo con otro editor aparecen aquí en cuanto los guardas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modification est enregistrée aussitôt dans config.json, et les modifications faites au fichier dans un autre éditeur apparaissent ici dès que vous les enregistrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modifica viene salvata subito in config.json, e le modifiche fatte al file con un altro editor compaiono qui appena le salvi."
          }
        }
      }
    },
