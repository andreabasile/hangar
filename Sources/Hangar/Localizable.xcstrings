    "Account folder: %@. On first launch %@ asks you to sign in. A separate account starts without your settings, MCP servers and plugins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account-Ordner: %@. Beim ersten Start bittet dich %@, dich anzumelden. Ein separater Account startet ohne deine Einstellungen, MCP-Server und Plug-ins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account folder: %@. On first launch %@ asks you to sign in. A separate account starts without your settings, MCP servers and plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta de la cuenta: %@. En el primer inicio, %@ te pide que inicies sesión. Una cuenta independiente empieza sin tus ajustes, servidores MCP ni plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier du compte : %@. Au premier lancement, %@ vous demande de vous connecter. Un compte distinct démarre sans vos réglages, serveurs MCP et plug-ins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella dell'account: %@. Al primo avvio %@ ti chiede di accedere. Un account separato parte senza le tue impostazioni, i server MCP e i plugin."
          }
        }
      }
    },
